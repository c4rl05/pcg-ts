                4.5
              ]
            },
            0
          ]
        }
      }
    },
    {
      "id": "tint",
      "type": "setAttribute",
      "params": {
        "name": "color",
        "domain": "point",
        "type": "f32",
        "tupleSize": 3,
        "value": {
          "fn": "vec",
          "args": [
            {
              "fn": "add",
              "args": [
                0.28,
                {
                  "fn": "mul",
                  "args": [
                    {
                      "fn": "component",
                      "args": [{ "fn": "attribute", "name": "cells" }],
                      "index": 0
                    },
                    0.62
                  ]
                }
              ]
            },
            {
              "fn": "add",
              "args": [
                0.11,
                {
                  "fn": "mul",
                  "args": [
                    {
                      "fn": "fract",
                      "args": [
                        {
                          "fn": "mul",
                          "args": [
                            {
                              "fn": "component",
                              "args": [{ "fn": "attribute", "name": "cells" }],
                              "index": 0
                            },
                            3.7
                          ]
                        }
                      ]
                    },
                    0.4
                  ]
                }
              ]
            },
            {
              "fn": "add",
              "args": [
                0.04,
                {
                  "fn": "mul",
                  "args": [
                    {
                      "fn": "fract",
                      "args": [
                        {
                          "fn": "mul",
                          "args": [
                            {
                              "fn": "component",
                              "args": [{ "fn": "attribute", "name": "cells" }],
                              "index": 0
                            },
                            7.1
                          ]
