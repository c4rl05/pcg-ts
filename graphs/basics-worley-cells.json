                "frequency": 0.11,
                "output": "cell",
                "position": { "fn": "position" }
              }
            },
            {
              "fn": "worleyNoise",
              "opts": {
                "seed": { "from": "node", "variant": 0 },
                "frequency": 0.11,
                "output": "f2-f1",
                "position": { "fn": "position" }
